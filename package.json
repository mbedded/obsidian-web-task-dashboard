{
  "name": "web-task-dashboard",
  "version": "1.1.0",
  "description": "Integrates your tasks from web services into Obsidian, allowing you to stay in Obsidian without distraction.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "svelte-check": "svelte-check --tsconfig tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run --tags-filter=\"!integration\"",
    "check-localization": "tsx scripts/validate-localizations.ts && tsx scripts/validate-localization-usage.ts"
  },
  "keywords": [],
  "author": "mbedded",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@babel/preset-typescript": "8.0.1",
    "@types/node": "26.6.3",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "builtin-modules": "5.4.0",
    "esbuild": "0.28.2",
    "esbuild-svelte": "0.9.5",
    "fast-xml-parser": "5.11.1",
    "obsidian": "1.13.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "svelte-preprocess": "6.0.5",
    "tslib": "2.8.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
